{
  "name": "chrome-ext-chordpro",
  "version": "1.6.0",
  "description": "A chrome extension working with ChordPro, built on React",
  "scripts": {
    "start": "react-scripts start",
    "build": "export NODE_OPTIONS=--openssl-legacy-provider && INLINE_RUNTIME_CHUNK=false react-scripts build && npm run post-build",
    "post-build": "node scripts/build.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "export NODE_OPTIONS=--openssl-legacy-provider && INLINE_RUNTIME_CHUNK=false react-scripts build && npm run post-build && npm run watch",
    "watch": "nodemon --watch src --exec 'npm run build'",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esack7/chrome-ext-chordpro.git"
  },
  "author": "Isaac Heist (isaacheist@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/esack7/chrome-ext-chordpro/issues"
  },
  "homepage": ".",
  "dependencies": {
    "pako": "^1.0.10",
    "prop-types": "^15.7.2",
    "react": "^16.11.0",
    "react-dom": "^16.11.0",
    "react-scripts": "^3.4.1",
    "styled-components": "^4.3.2",
    "styled-reset": "^3.0.0",
    "uuid": "^3.3.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.323",
    "eslint-config-airbnb": "^17.1.1",
    "eslint-config-prettier": "^6.0.0",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-react": "^7.37.5",
    "nodemon": "^3.1.10",
    "prettier": "^1.18.2",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
